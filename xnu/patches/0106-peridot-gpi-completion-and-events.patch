+/* Count the event classes a transfer produced and print the first ones. */
+static void
+pg_event_log(const struct pg_tre *ev)
+{
+	uint32_t type = (ev->d[3] >> 16) & 0xff, chid = ev->d[3] >> 24;
+	uint32_t code = (ev->d[2] >> 24) & 0xff, len = ev->d[2] & 0xffffff;
+	for (unsigned i = 0; i < pg_evbn; ++i) {
+		if (pg_evb[i].type == type && pg_evb[i].chid == chid &&
+		    pg_evb[i].code == code) {
+			pg_evb[i].count++;
+			return;
+		}
+	}
+	if (pg_evbn >= PG_EVB) {
+		return;
+	}
+	pg_evb[pg_evbn].type = type;
+	pg_evb[pg_evbn].chid = chid;
+	pg_evb[pg_evbn].code = code;
+	pg_evb[pg_evbn].len = len;
+	pg_evb[pg_evbn].ptrlo = ev->d[0];
+	pg_evb[pg_evbn].count = 1;
+	pg_evbn++;
+	printf("PERIDOT GPI: event class type=%#x chid=%u code=%#x len=%u ptr=%#x\n",
+	    type, chid, code, len, ev->d[0]);
+}
