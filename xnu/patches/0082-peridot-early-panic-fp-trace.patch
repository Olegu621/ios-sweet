diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 24f1abc..d275cfe 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -39,6 +39,10 @@
 #include <arm64/monotonic.h>
 #include <arm64/instructions.h>
 
+#if defined(SWEET)
+#include <arm64/sweet_early.h>
+#endif
+
 #include <kern/debug.h>
 #include <kern/restartable.h>
 #include <kern/socd_client.h>
@@ -463,6 +467,14 @@ arm64_platform_error(arm_saved_state_t *state, uint32_t esr, vm_offset_t far, pl
 void
 panic_with_thread_kernel_state(const char *msg, arm_saved_state_t *ss)
 {
+#if defined(SWEET)
+	/*
+	 * peridot: caller chain straight from the saved frame pointers.
+	 * Print it before anything else so a nested fault cannot pre-empt
+	 * it; the early console's once-only gate makes re-entry safe.
+	 */
+	sweet_early_trace(saved_state64(ss)->fp);
+#endif
 	boolean_t ss_valid;
 
 	ss_valid = is_saved_state64(ss);
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index cac7201..ee306a8 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -10,6 +10,7 @@
 #if defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
+#include <mach/vm_types.h>
 
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0xe3940000;
 #define EARLY_FB early_fb
@@ -140,4 +141,68 @@ sweet_early_disable(void)
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }
+
+void
+sweet_early_hex(unsigned long long v)
+{
+	static const char digits[] = "0123456789abcdef";
+	char buf[24];
+	int i = 23;
+
+	buf[0] = '0';
+	buf[1] = 'x';
+	do {
+		buf[--i] = digits[v & 0xf];
+		v >>= 4;
+	} while (v != 0 && i > 2);
+	sweet_early_string(&buf[i]);
+}
+
+void
+sweet_early_dec(unsigned long v)
+{
+	char buf[24];
+	int i = 23;
+
+	if (v == 0) {
+		sweet_early_string("0");
+		return;
+	}
+	while (v != 0) {
+		buf[--i] = (char)('0' + v % 10);
+		v /= 10;
+	}
+	sweet_early_string(&buf[i]);
+}
+
+/*
+ * Caller chain of the faulting frame: fp_i holds the caller's LR at
+ * fp_i+8 and the next frame pointer at fp_i.  Kernel VAs only, bounded
+ * depth; a read that faults re-enters sleh whose early-panic gate is
+ * already latched, so the second print is a no-op instead of a hang.
+ */
+void
+sweet_early_trace(vm_offset_t fp)
+{
+	int depth;
+
+	sweet_early_string("\nTRACE ");
+	for (depth = 0; depth < 6; depth++) {
+		vm_offset_t lr;
+		vm_offset_t next;
+
+		if (fp < 0xfffffe0000000000ULL || fp > 0xfffffeff00000000ULL) {
+			break;
+		}
+		lr = *(vm_offset_t *)(fp + 8);
+		next = *(vm_offset_t *)fp;
+		sweet_early_hex(lr);
+		sweet_early_putc(' ');
+		if (next <= fp) {
+			break;
+		}
+		fp = next;
+	}
+	sweet_early_putc('\n');
+}
 #endif /* SWEET */
