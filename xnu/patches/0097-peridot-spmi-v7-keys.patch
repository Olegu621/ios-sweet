-/*
- * Probe the PMIC key blocks as soon as the kernel is up and log the values:
- * PMK8550 (slave 0) pon_hlos 0x1300 (power key bit 7, resin bit 6) and
- * RT 0x1310, PMXR2230 (slave 1) RT 0x8d10 (volume up GPIO 6).
- */
-__attribute__((constructor))
+
+/* Two equal polls (40 ms) debounce both edges. On loss of a channel,
+ * release any reported down state so a failed read cannot stick a key. */
 static void
-sweet_spmi_probe(void)
+sp_key_update(int key, bool valid, int sample, int *state, int *candidate, int *ticks)
 {
-	uint8_t v = 0;
-	int r1, r2, r3;
-	uint8_t hlos = 0, rt = 0, vol = 0;
-
-	if (sweet_spmi_p_init() != 0) {
-		printf("SWEET SPMI: peridot init failed\n");
+	if (!valid) {
+		if (*state) {
+			*state = 0;
+			sweet_hid_key(key, 0);
+		}
+		*ticks = 0;
 		return;
 	}
-	r1 = sweet_spmi_p_read(0, 0x1300, &v);
-	hlos = v;
-	r2 = sweet_spmi_p_read(0, 0x1310, &v);
-	rt = v;
-	r3 = sweet_spmi_p_read(1, 0x8d10, &v);
-	vol = v;
-	printf("SWEET SPMI: pmk8550 pon_hlos %02x (r%d) rt %02x (r%d), pmxr2230 rt %02x (r%d)\n",
-	    hlos, r1, rt, r2, vol, r3);
+	if (sample != *candidate) {
+		*candidate = sample;
+		*ticks = 1;
+	} else if (*ticks < 2) {
+		++*ticks;
+	}
+	if (*ticks == 2 && *state != sample) {
+		*state = sample;
+		printf("PERIDOT KEYS: key=%d down=%d\n", key, sample);
+		sweet_hid_key(key, sample);
+	}
+}
+
+static void
+sp_keys_thread(__unused void *arg, __unused wait_result_t result)
+{
+	int state[3] = {0}, candidate[3] = {0}, ticks[3] = {0};
+	for (;;) {
+		uint8_t pon = 0, gpio = 0;
+		bool pok = sp_pon_ok && sp_read(0, 0x1310, &pon);
+		bool gok = sp_gpio_ok && sp_read(1, 0x8d10, &gpio);
+		sp_key_update(0, pok, !!(pon & 0x80), &state[0], &candidate[0], &ticks[0]);
+		sp_key_update(1, gok, !(gpio & 1), &state[1], &candidate[1], &ticks[1]);
+		sp_key_update(2, pok, !!(pon & 0x40), &state[2], &candidate[2], &ticks[2]);
+		uint64_t deadline;
+		clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&sp_sleep_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+/* Called only on SM8635, after UFS diagnostics have started. No early
+ * constructor: any failure here can now be captured by the disk logger. */
+void
+sweet_peridot_keys_init(void)
+{
+	uint32_t enabled = 1;
+	thread_t thread;
+	if (sp_attempted) {
+		return;
+	}
+	sp_attempted = true;
+	PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("PERIDOT KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	sp_core = ml_io_map(SP_CORE_PA, 0x3000);
+	sp_cfg = ml_io_map(SP_CFG_PA, 0x4000);
+	sp_obs = ml_io_map(SP_OBS_PA, 0x80000);
+	if (!sp_core || !sp_cfg || !sp_obs) {
+		printf("PERIDOT KEYS: MMIO mapping failed\n");
+		return;
+	}
+	uint32_t version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (version < 0x70000000u || version >= 0x80000000u ||
+	    !sp_count || sp_count > SP_MAX_APIDS) {
+		printf("PERIDOT KEYS: unsupported arb=%#x APIDs=%u\n", version, sp_count);
+		return;
+	}
+	sp_pon_apid = sp_find_apid(SP_PON_PPID);
+	sp_gpio_apid = sp_find_apid(SP_GPIO_PPID);
+	sp_ready = true;
+	uint8_t pon = 0, gpio = 0, pon_type = 0, subtype = 0, mode = 0, en = 0;
+	sp_pon_ok = sp_read(0, 0x1305, &pon_type) && pon_type == 9 && sp_read(0, 0x1310, &pon);
+	sp_gpio_ok = sp_read(1, 0x8d05, &subtype) &&
+	    subtype >= 0x10 && subtype <= 0x13 &&
+	    sp_read(1, 0x8d40, &mode) && (mode & 3) == 0 &&
+	    sp_read(1, 0x8d46, &en) && (en & 0x80) && sp_read(1, 0x8d10, &gpio);
+	printf("PERIDOT KEYS: arb=%#x APIDs=%u pon-apid=%u gpio6-apid=%u\n",
+	    version, sp_count, sp_pon_apid, sp_gpio_apid);
+	printf("PERIDOT KEYS: PON type=%#x RT=%#x ok=%d; GPIO6 subtype=%#x mode=%#x en=%#x RT=%#x ok=%d\n",
+	    pon_type, pon, sp_pon_ok, subtype, mode, en, gpio, sp_gpio_ok);
+	if (!sp_pon_ok && !sp_gpio_ok) {
+		printf("PERIDOT KEYS: no validated key channels; polling withheld\n");
+		return;
+	}
+	if (kernel_thread_start(sp_keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("PERIDOT KEYS: polling power, volume-up, volume-down at 20 ms\n");
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
