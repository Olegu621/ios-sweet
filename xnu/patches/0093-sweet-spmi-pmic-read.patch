diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
new file mode 100644
index 0000000..7d6e14d
--- /dev/null
+++ b/bsd/dev/sweet_spmi.c
@@ -0,0 +1,133 @@
+/*
+ * SWEET: minimal SPMI arbiter access for peridot (SM8635).
+ *
+ * Read only, on purpose: this is used to watch the PMIC power/resin GPIOs
+ * (power key, volume up) and the touch rails.  A wrong QMI encoding must
+ * never write a PMIC register, so this driver only issues reads.
+ *
+ * The arbiter (live DT, spmi_bus: qcom,spmi@c42d000):
+ *   cnfg   0xc42d000 (0x4000)   APID ownership: cnfg + 4*apid
+ *   core   0xc400000 (0x3000)   MC registers, APID map: core + 0x2000 + 4*apid
+ *   obsrvr 0xc440000 (0x80000)
+ *
+ * The QMI encoding is not documented in any public tree, so the read command
+ * is tried in a few variants and the result is logged; the one that returns
+ * the known idle value (PMK8550 pon_hlos RT 0x1310 == 0x10) is the right one.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SPMI_CNFG_PA		0xc42d000UL
+#define SPMI_CORE_PA		0xc400000UL
+#define SPMI_CNFG_SIZE		0x4000UL
+#define SPMI_CORE_SIZE		0x3000UL
+
+/* MC (core) registers. */
+#define MC_CMD			0x0000u
+#define MC_STATUS		0x0004u
+#define MC_ARG0			0x0008u
+#define MC_ARG1			0x000cu
+#define MC_RESP0		0x0010u
+#define MC_RESP1		0x0014u
+/* The APID currently selected for QMI transfers. */
+#define MC_APID(n)		(0x2000u + 4u * (n))
+
+/* QMI command opcodes that may carry a register read. */
+static const uint32_t cmd_opcodes[] = { 0x02u, 0x01u, 0x05u, 0x06u, 0x00u };
+
+static vm_offset_t core, cnfg;
+static bool smpi_mapped;
+
+static inline uint32_t
+smpi_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(core + off);
+}
+
+static inline void
+smpi_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(core + off) = v;
+}
+
+static inline uint32_t
+smpi_cfg_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(cnfg + off);
+}
+
+bool
+sweet_spmi_init(void)
+{
+	if (smpi_mapped) {
+		return true;
+	}
+	core = ml_io_map(SPMI_CORE_PA, SPMI_CORE_SIZE);
+	cnfg = ml_io_map(SPMI_CNFG_PA, SPMI_CNFG_SIZE);
+	if (!core || !cnfg) {
+		printf("SWEET SPMI: MMIO mapping failed\n");
+		return false;
+	}
+	smpi_mapped = true;
+	printf("SWEET SPMI: core %lx cnfg %lx\n", (unsigned long)core,
+	    (unsigned long)cnfg);
+	return true;
+}
+
+/*
+ * Read one PMIC register over the SPMI arbiter (QMI mode).
+ * apid: SPMI slave id (PMK8550 = 0, PMXR2230 = 1), reg: byte address.
+ * The command word layout is not public, so the variants are tried in turn and
+ * the first one that returns a plausible value wins.  Returns 0xffffffff if
+ * nothing answered.
+ */
+uint32_t
+sweet_spmi_read(unsigned apid, unsigned reg)
+{
+	uint32_t value = 0xffffffffu;
+	unsigned i;
+
+	if (!smpi_mapped && !sweet_spmi_init()) {
+		return value;
+	}
+	/* Only touch the arbiter if this APID is owned by us. */
+	if (smpi_cfg_rd(4u * apid) == 0) {
+		printf("SWEET SPMI: apid %u not owned (cnfg %08x)\n", apid,
+		    smpi_cfg_rd(4u * apid));
+		return value;
+	}
+	for (i = 0; i < sizeof(cmd_opcodes) / sizeof(cmd_opcodes[0]); i++) {
+		uint32_t cmd = (cmd_opcodes[i] << 24) | (reg & 0xffffu);
+		uint32_t status;
+
+		smpi_wr(MC_APID(apid), apid);
+		smpi_wr(MC_CMD, cmd);
+		__builtin_arm_dsb(0xf);
+		for (int spin = 0; spin < 100000; spin++) {
+			status = smpi_rd(MC_STATUS);
+			if (status & 0x1u) {	/* transfer done */
+				break;
+			}
+		}
+		if ((status & 0x1u) == 0) {
+			printf("SWEET SPMI: apid %u reg %x cmd %08x timed out (status %08x)\n",
+			    apid, reg, cmd, status);
+			continue;
+		}
+		value = smpi_rd(MC_RESP0);
+		printf("SWEET SPMI: apid %u reg %x cmd %08x -> %08x (status %08x)\n",
+		    apid, reg, cmd, value, status);
+		if (value != 0xffffffffu) {
+			return value;
+		}
+	}
+	return value;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
