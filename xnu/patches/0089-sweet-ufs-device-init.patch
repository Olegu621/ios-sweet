 /*
- * The SCSI path through the UTR list is the only judge of a healthy device:
- * any TEST UNIT READY answer (GOOD, or a refusing CHECK CONDITION) proves the
- * UIC link and the UTP layer are alive, and DME link commands play no part in
- * that state. UIC commands even never complete on this controller after the
- * bootloader (observed on 0051p: DME RESET/LINK STARTUP time out with IS 0),
- * so run them only for a doorbell that never clears.
+ * DME GET / DME SET of a PA layer attribute (UniPro 1.8, JESD220).
+ * The attribute number goes into ARG_1 shifted up by 16 bits
+ * (UIC_ARG_MIB), the value into ARG_3.
+ */
+static uint32_t
+ufs_dme_get(uint32_t mib, uint32_t *val)
+{
+	uint32_t v = 0;
+	uint32_t r = ufs_uic(0x01, mib << 16, 0, 0, &v);
+
+	if (val) {
+		*val = v;
+	}
+	printf("SWEET UFS: DME GET mib 0x%x result %u value 0x%x\n", mib, r, v);
+	return r;
+}
+
+static uint32_t
+ufs_dme_set(uint32_t mib, uint32_t val)
+{
+	uint32_t r = ufs_uic(0x02, mib << 16, 0, val, NULL);
+
+	printf("SWEET UFS: DME SET mib 0x%x value 0x%x result %u\n", mib, val, r);
+	return r;
