+/*
+ * Configure the M-PHY for the negotiated gear and move the device into the
+ * Fast power mode (Linux ufshcd_dme_change_power_mode).  The PA layer
+ * attribute numbers are the UniPro 1.8 ones (JESD220).
+ */
+static void
+ufs_power_mode(void)
+{
+	uint32_t lanes_rx = 0, lanes_tx = 0, gear_rx = 0, gear_tx = 0, v = 0;
+
+	ufs_dme_get(0x1581, &lanes_rx);         /* PA_CONNECTEDRXDATALANES */
+	ufs_dme_get(0x1561, &lanes_tx);         /* PA_CONNECTEDTXDATALANES */
+	ufs_dme_get(0x1587, &gear_rx);          /* PA_MAXRXHSGEAR */
+	ufs_uic(0x03, 0x1587 << 16, 0, 0, &gear_tx);   /* peer: PA_MAXRXHSGEAR */
+	if (!gear_tx) {
+		gear_tx = gear_rx;
+	}
+	ufs_dme_get(0x1571, &v);                /* PA_PWRMODE */
+	printf("SWEET UFS: lanes %u/%u gears %u/%u power mode 0x%x\n",
+	    lanes_rx, lanes_tx, gear_rx, gear_tx, v);
+
+	ufs_dme_set(0x1583, gear_rx);           /* PA_RXGEAR */
+	ufs_dme_set(0x1580, lanes_rx);          /* PA_ACTIVERXDATALANES */
+	ufs_dme_set(0x1584, 1);                 /* PA_RXTERMINATION */
+	ufs_dme_set(0x1568, gear_tx);           /* PA_TXGEAR */
+	ufs_dme_set(0x1560, lanes_tx);          /* PA_ACTIVETXDATALANES */
+	ufs_dme_set(0x1569, 1);                 /* PA_TXTERMINATION */
+	ufs_dme_set(0x156a, 2);                 /* PA_HSSERIES: rate B */
+	ufs_dme_set(0x1571, 0x11);              /* PA_PWRMODE: fast / fast */
+	ufs_dme_get(0x1571, &v);
+	printf("SWEET UFS: power mode now 0x%x\n", v);
+}
