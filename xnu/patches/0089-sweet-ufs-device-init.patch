+/*
+ * The UFS 3.0/4.0 device initialisation handshake: the host sets the
+ * fDeviceInit flag and waits for the device to clear it again (Linux
+ * ufshcd_complete_dev_init).  The device descriptor of this UFS 4.0 part
+ * says bInitialPowerMode = 01h, i.e. the device comes up in Sleep power
+ * mode and answers every SCSI command with CHECK CONDITION / NOT READY
+ * until the host has moved it out of it.
+ */
+static int
+ufs_fdeviceinit(void)
+{
+	uint32_t v = 0, r;
+
+	r = ufs_query(0x06, 0x01, 0, NULL);     /* SET_FLAG fDeviceInit */
+	printf("SWEET UFS: fDeviceInit set result %u\n", r);
+	for (int i = 0; i < 50; i++) {
+		v = 0xffffffff;
+		r = ufs_query(0x05, 0x01, 0, &v); /* READ_FLAG fDeviceInit */
+		printf("SWEET UFS: fDeviceInit read result %u value 0x%x\n", r, v);
+		if (r == 0 && !(v & 1)) {
+			return 0;
+		}
+	}
+	return EIO;
+}
