+/*
+ * START STOP UNIT on the well known "device" LUN (the UPIU LUN byte of
+ * SCSI LUN 0xc150 is 0xd0).  The power condition modifier selects the
+ * device power mode: 0x00 active, 0x10 sleep, 0x20 power down.  Going
+ * down and up again is the UFS level equivalent of the VCC toggle the
+ * reference driver does with the device.
+ */
+static int
+ufs_start_stop(uint8_t pcm)
+{
+	uint8_t cdb[6] = { 0x1e, 0, 0, 0, pcm, 0 };
+	uint8_t lun = su.lun;
+	int error;
+
+	su.lun = 0xd0;                          /* the well known device LUN */
+	error = ufs_scsi(cdb, sizeof(cdb), 0, false);
+	su.lun = lun;
+	printf("SWEET UFS: START STOP UNIT pcm 0x%x: %s\n", pcm,
+	    error ? "refused" : "ok");
+	return error;
+}
