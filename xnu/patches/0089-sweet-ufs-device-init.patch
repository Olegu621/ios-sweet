+/*
+ * A NOP OUT UPIU (type 0x00).  The reference driver sends it as the very
+ * first thing after the link is up: the device answers with a NOP IN and
+ * that proves it has finished its own initialisation.
+ */
+static int
+ufs_nop_out(void)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+	uint32_t ocs;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x00;                     /* NOP OUT UPIU */
+	ucd->cmd[3] = ++su.tag;
+
+	utrd->dw0 = (1u << 28) | (1u << 24);    /* CT=1, DD=0, I=1 */
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: NOP OUT timed out\n");
+			return ETIMEDOUT;
 		}
-		printf("SWEET UFS: HCS after DME RESET 0x%x\n", hcs);
+		delay(1);
 	}
-	r = ufs_uic(0x16, 0);                   /* DME LINK STARTUP */
-	printf("SWEET UFS: DME LINK STARTUP result 0x%x\n", r);
-	return ((r != 0xffffffffu) && ((r & 0xffff) == 0)) ? 0 : ENXIO;
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	ocs = utrd->dw2 & 0xff;
+	printf("SWEET UFS: NOP OUT ocs 0x%x upiu 0x%x\n", ocs, ucd->resp[0]);
+	return ocs ? EIO : 0;
+}
