+/*
+ * A QUERY request (UPIU type 0x16).  The payload is "struct utp_upiu_query":
+ * opcode, idn, index, selector, reserved, length, value, reserved.  The
+ * answer arrives in the QUERY response UPIU (type 0x36); its value field
+ * sits at offset 20 (12 byte UPIU header + 8).
+ */
+static int
+ufs_query(uint8_t opcode, uint8_t idn, uint32_t value, uint32_t *rsp_value)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+	uint32_t ocs;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x16;                     /* QUERY REQUEST UPIU */
+	ucd->cmd[1] = 0x00;
+	ucd->cmd[2] = 0x00;                     /* LUN */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[4] = 0x00;                     /* command set type / IID */
+	ucd->cmd[5] = (opcode == 0x05) ? 0x01 : 0x81;   /* query function */
+	/*
+	 * The query payload starts right behind the 12 byte UPIU header
+	 * (struct utp_upiu_query), not behind a data length field like the
+	 * command UPIU has: opcode, idn, index, selector, reserved, length,
+	 * value.
+	 */
+	ucd->cmd[12] = opcode;
+	ucd->cmd[13] = idn;
+	ucd->cmd[14] = 0;                       /* index */
+	ucd->cmd[15] = 0;                       /* selector */
+	ucd->cmd[18] = 0;                       /* length */
+	ucd->cmd[19] = 0;
+	ucd->cmd[20] = (uint8_t)(value >> 24);
+	ucd->cmd[21] = (uint8_t)(value >> 16);
+	ucd->cmd[22] = (uint8_t)(value >> 8);
+	ucd->cmd[23] = (uint8_t)value;
+
+	/* No data phase: DD = 0, command type 1 (UFS storage device). */
+	utrd->dw0 = (1u << 28) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 24);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: QUERY 0x%02x timed out\n", opcode);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+
+	ocs = utrd->dw2 & 0xff;
+	uint32_t type = ucd->resp[0], rcode = ucd->resp[6];
+	uint32_t v = (ucd->resp[20] << 24) | (ucd->resp[21] << 16) |
+	    (ucd->resp[22] << 8) | ucd->resp[23];
+	if (rsp_value) {
+		*rsp_value = v;
+	}
+	printf("SWEET UFS: QUERY opcode 0x%02x idn 0x%02x: ocs 0x%x type 0x%x code 0x%x value 0x%x\n",
+	    opcode, idn, ocs, type, rcode, v);
+	if (ocs || type != 0x36 || rcode) {
+		return EIO;
+	}
+	return 0;
+}
