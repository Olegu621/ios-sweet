-/* Leave global translation and all existing mappings intact. If the ring/data SID is
- * unmatched/faulting, install one exact-ID bypass in an unused SMR before
- * issuing any DMA. Only this kernel driver can submit GPI descriptors. */
+/* Some Qualcomm firmware substitutes BYPASS with FAULT (Linux
+ * qcom_smmu_write_s2cr). Reuse only an already referenced, disabled S1
+ * context with stage2 bypass; never write SCTLR/CBAR or change a live bank. */
+static bool
+pg_cb_physical(vm_offset_t smmu, uint32_t id1, unsigned cb)
+{
+	unsigned shift = (id1 & 0x80000000u) ? 16 : 12;
+	unsigned pages = 1u << (((id1 >> 28) & 7) + 1);
+	uint64_t base = (uint64_t)pages << shift;
+	if (cb >= (id1 & 0xff) || base + ((uint64_t)(cb + 1) << shift) > 0x100000) {
+		return false;
+	}
+	uint32_t cbar = pg_rd(smmu, (1u << shift) + 4 * cb);
+	uint32_t sctlr = pg_rd(smmu, (unsigned)(base + ((uint64_t)cb << shift)));
+	bool ok = ((cbar >> 16) & 3) == 1 && !(sctlr & 1) && sctlr != 0xffffffffu;
+	printf("PERIDOT GPI: CB%u CBAR=%#x SCTLR=%#x existing physical=%d\n", cb, cbar, sctlr, ok);
+	return ok;
+}
+
+static bool
+pg_s2cr_physical(vm_offset_t smmu, uint32_t id1, uint32_t s2cr)
+{
+	unsigned type = (s2cr >> 16) & 3;
+	return type == 1 || (type == 0 && pg_cb_physical(smmu, id1, s2cr & 0xff));
+}
+
+static int
+pg_boot_bypass_cb(vm_offset_t smmu, uint32_t cr0, uint32_t id1, unsigned count)
+{
+	for (unsigned i = 0; i < count; ++i) {
+		uint32_t smr = pg_rd(smmu, 0x800 + 4 * i), co = pg_rd(smmu, 0xc00 + 4 * i);
+		bool valid = (cr0 & 8) ? (co & 0x400) != 0 : (smr & 0x80000000u) != 0;
+		if (valid && ((co >> 16) & 3) == 0 && pg_cb_physical(smmu, id1, co & 0xff)) {
+			printf("PERIDOT GPI: reuse boot physical CB%u referenced by SMR%u SID=%#x\n",
+			    co & 0xff, i, smr & 0xffff);
+			return co & 0xff;
+		}
+	}
+	return -1;
+}
