+static const struct cdevsw sweet_ufs_cdevsw = {
+	.d_open       = sweet_ufs_open,
+	.d_close      = sweet_ufs_close,
+	.d_read       = sweet_ufs_read,
+	.d_write      = sweet_ufs_write,
+	.d_ioctl      = sweet_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+/* The compiled key/touch/USB probes below use SM7150 register addresses.
+ * They must not access those addresses on SM8635 while its drivers are
+ * being ported. Device identity reported to iOS is the same on both boards,
+ * so use the SoC compatible string rather than the iPhone model. */
+static bool
+sweet_legacy_peripherals(void)
+{
+	DTEntry root;
+	const char *compat;
+	unsigned size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", (const void **)&compat, &size) != kSuccess) {
+		return true;
+	}
+	for (unsigned off = 0; off < size;) {
+		size_t len = strnlen(compat + off, size - off);
+		if (len == size - off) {
+			break;
+		}
+		if (strcmp(compat + off, "qcom,sm8635") == 0) {
+			return false;
+		}
+		off += (unsigned)len + 1;
+	}
+	return true;
+}
+
+static int
+sweet_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	/* Keep the failing UFS bring-up and panic even before disk logs work. */
+	sweet_ramoops_init();
+
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET UFS: no /sweet-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	uint32_t rw = 0;
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+	uint32_t cache = 0, wait = 0;
+	PE_parse_boot_argn("ufscache", &cache, sizeof(cache));
+	PE_parse_boot_argn("ufswait", &wait, sizeof(wait));
+	su.cache = (cache == 1);
+	su.wait = (wait == 1);
+
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		error = ufs_link_init();
+	}
+	if (!error) {
+		/* The reset invalidated our transfer request list: take it again. */
+		error = ufs_take_over_host();
+	}
+	if (!error) {
+		/* NOP OUT, fDeviceInit, the descriptors, the power mode. */
+		ufs_device_init();
+	}
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* The first command after the reset may report a unit attention. */
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+		}
+		printf("SWEET UFS: TEST UNIT READY: %s\n", error ? "refused" : "good");
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	/* Only now, with the partition bounds known, can writes be allowed. */
+	su.writable = (rw != 0);
+	su.ready = true;
+	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
+	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	sweet_log_start();
+	sweet_diag_start();
+	/*
+	 * PMIC inputs over SPMI: the power key is PMK8550 (sid 0) pon_hlos
+	 * 0x1300 bit 7, the resin (volume up) is the same block bit 6, and the
+	 * volume up key is PMXR2230 (sid 1) GPIO 6 with the RT status at
+	 * 0x8d10.  Read only.
+	 */
+	if (sweet_spmi_init() == 0) {
+		uint8_t v = 0;
+		int r1 = sweet_spmi_read(0, 0x1300, &v);
+		uint8_t hlos = v;
+		int r2 = sweet_spmi_read(0, 0x1310, &v);
+		uint8_t rt = v;
+		int r3 = sweet_spmi_read(1, 0x8d10, &v);
+		uint8_t vol = v;
+		printf("SWEET SPMI: pmk8550 pon_hlos %02x (r%d) rt %02x (r%d), pmxr2230 rt %02x (r%d)\n",
+		    hlos, r1, rt, r2, vol, r3);
+	} else {
+		printf("SWEET SPMI: init failed\n");
+	}
+	uint32_t panic_probe = 0;
+	PE_parse_boot_argn("sweetpanicprobe", &panic_probe, sizeof(panic_probe));
+	if (panic_probe == 1) {
+		panic("SWEET DIAG: controlled panic after UFS init");
+	}
+	sweet_sample_start();
+	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
+	if (sweet_legacy_peripherals()) {
+		sweet_keys_init();
+		sweet_touch_init();
+		sweet_usb_probe();
+	} else {
+		printf("SWEET PERIPHERALS: SM8635; SM7150 key/touch/USB probes withheld\n");
+	}
+	return 0;
+}
+
+/*
+ * Persistent console log ("sweetlog"). Filming the phone screen is the only
+ * other way to see the console, so every character that reaches the
+ * console (kernel printf and /dev/console writes of daemons, both through
+ * _cnputs) is also kept in a 4 MiB ring, and once the partition is known
+ * and writable a thread copies new ring blocks to the LAST 4 MiB + 4 KiB of
+ * the partition every ufslogsecs seconds (default 10), far behind the HFS
+ * image at its start. Device block 0 of that area is a header:
+ *   "SWEETLOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   | u64 flush sequence
+ * ring offset of byte n = n % ring size. Read it from a recovery with
+ * tools/sweet-log-pull.sh. Disabled with boot-arg sweetlog=0.
+ */
+#define SWEET_LOG_SIZE          (4u << 20)
+#define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
+#define SWEET_LOG_SECS          10u
+
+static char sweet_log_ring[SWEET_LOG_SIZE];
+static uint64_t _Atomic sweet_log_total;
+static int sweet_log_chan;
+static uint32_t sweet_log_secs = SWEET_LOG_SECS;
+
+/* Linux fs/pstore/ram_core.c's non-ECC console ring (12-byte header).
+ * The ADT names recovery-reserved RAM outside the XNU-managed bank.
+ * Map it uncached: a panic must not require UFS, cache flushing or a worker.
+ */
+struct sweet_ramoops_header {
+	uint32_t sig, start, size;
+	uint8_t data[];
+};
+static volatile struct sweet_ramoops_header *sweet_ramoops;
+static uint32_t sweet_ramoops_capacity;
+static uint32_t _Atomic sweet_ramoops_busy;
+
+static void
+sweet_ramoops_append(const char *c, int size)
+{
+	volatile struct sweet_ramoops_header *r = sweet_ramoops;
+	if (r == NULL || size <= 0 ||
+	    !os_atomic_cmpxchg(&sweet_ramoops_busy, 0, 1, acquire)) {
+		return; /* Never wait for a stopped CPU or a nested panic. */
+	}
+	uint32_t at = r->start, used = r->size;
+	for (int i = 0; i < size; i++) {
+		r->data[at++] = (uint8_t)c[i];
+		if (at == sweet_ramoops_capacity) {
+			at = 0;
+		}
+		if (used < sweet_ramoops_capacity) {
+			used++;
+		}
+	}
+	__builtin_arm_dsb(0xf);
+	r->start = at;
+	r->size = used;
+	__builtin_arm_dsb(0xf);
+	os_atomic_store(&sweet_ramoops_busy, 0, release);
+}
+
+/* Early panic/trace bypasses _cnputs; retain that path too. */
+void sweet_ramoops_putc(char c);
+void
+sweet_ramoops_putc(char c)
+{
+	sweet_ramoops_append(&c, 1);
+}
+
+static void
+sweet_ramoops_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetramoops", &on, sizeof(on));
+	if (!on || sweet_ramoops != NULL ||
+	    SecureDTLookupEntry(NULL, "/sweet-ramoops", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size != 2 * sizeof(uintptr_t) || reg[1] < PAGE_SIZE || reg[1] > (4u << 20)) {
+		return;
+	}
+	volatile struct sweet_ramoops_header *r =
+	    (volatile struct sweet_ramoops_header *)ml_io_map(reg[0], reg[1]);
+	if (r == NULL) {
+		return;
+	}
+	sweet_ramoops_capacity = (uint32_t)reg[1] - sizeof(*r);
+	r->sig = 0;
+	r->start = 0;
+	r->size = 0;
+	__builtin_arm_dsb(0xf);
+	r->sig = 0x43474244; /* PERSISTENT_RAM_SIG, console type has seed 0. */
+	__builtin_arm_dsb(0xf);
+	sweet_ramoops = r;
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t pos = total > sweet_ramoops_capacity ? total - sweet_ramoops_capacity : 0;
+	while (pos < total) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t n = (uint32_t)MIN(total - pos, (uint64_t)(SWEET_LOG_SIZE - off));
+		sweet_ramoops_append(sweet_log_ring + off, (int)n);
+		pos += n;
+	}
+	printf("SWEET RAMOOPS: console at 0x%lx, %u bytes, recovery pstore format\n",
+	    (unsigned long)reg[0], sweet_ramoops_capacity);
+}
+
+/* Called for all console output, any context: never blocks. */
+void sweet_log_append(const char *c, int size);
+
+void
+sweet_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	sweet_ramoops_append(c, size);
+	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+	}
+}
+
+/*
+ * Copy console bytes [*pos, total) (at most max) for live log streaming
+ * (sweet_usb.c). A reader that fell more than the ring behind skips ahead.
+ * Returns the byte count; *pos advances.
+ */
+uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint32_t
+sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total - *pos > SWEET_LOG_SIZE) {
+		*pos = total - SWEET_LOG_SIZE;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = sweet_log_ring[(*pos + i) % SWEET_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t sweet_log_position(void);
+
+uint64_t
+sweet_log_position(void)
+{
+	return os_atomic_load(&sweet_log_total, relaxed);
+}
+
+struct sweet_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+/* Save the first panic before entering the debugger. No allocation, no
+ * waiting for a mutex, no sleeping while polling UFS. If a UFS operation
+ * owns the slot, leave its descriptors and bounce buffer alone. Writes
+ * still go through ufs_write_blocks' normal userdata bounds checks. */
+void sweet_log_panic_flush(void);
+void
+sweet_log_panic_flush(void)
+{
+	if (!su.ready || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS ||
+	    !lck_mtx_try_lock(&sweet_ufs_lock)) {
+		return;
+	}
+	bool wait = su.wait;
+	su.wait = false;
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+	for (uint32_t off = 0; off < SWEET_LOG_SIZE && !error; off += BOUNCE_SIZE) {
+		memcpy(bounce, sweet_log_ring + off, BOUNCE_SIZE);
+		error = ufs_write_blocks(base + 1 + off / UFS_BLOCK, BOUNCE_SIZE / UFS_BLOCK);
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = UINT64_MAX,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		(void)ufs_sync_cache();
+	}
+	su.wait = wait;
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
+
+/* Explicit diagnostic boot only. The host sets BCB boot-recovery before
+ * fastboot boot, so PSCI reset returns to recovery for automatic log pull. */
+static uint32_t sweet_diag_seconds, sweet_diag_panic_reset;
+
+static void
+sweet_diag_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000009; /* PSCI SYSTEM_RESET */
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__builtin_arm_dsb(0xf);
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) :: "memory");
+}
+
+void sweet_diag_panic_done(void);
+void
+sweet_diag_panic_done(void)
+{
+	if (sweet_diag_panic_reset) {
+		sweet_diag_reset();
+	}
+}
+
+static void
+sweet_diag_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	(void)tsleep(&chan, PZERO, "sweetdiag", hz * (int)sweet_diag_seconds);
+	printf("SWEET DIAG: timed capture after %u seconds; resetting to recovery\n",
+	    sweet_diag_seconds);
+	sweet_log_panic_flush();
+	sweet_diag_reset();
+}
+
+static void
+sweet_diag_start(void)
+{
+	thread_t thread;
+	PE_parse_boot_argn("sweetpanicreset", &sweet_diag_panic_reset, sizeof(sweet_diag_panic_reset));
+	PE_parse_boot_argn("sweetdiagreset", &sweet_diag_seconds, sizeof(sweet_diag_seconds));
+	if (sweet_diag_seconds >= 30 && sweet_diag_seconds <= 3600 &&
+	    kernel_thread_start(sweet_diag_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET DIAG: automatic recovery reset in %u seconds\n", sweet_diag_seconds);
+	}
+}
+
+static void
+sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
+	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	for (;;) {
+		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&sweet_ufs_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+			uint32_t blk = off / UFS_BLOCK;
+			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+			memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+			error = ufs_write_blocks(base + 1 + blk, n);
+			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+		}
+		if (!error) {
+			struct sweet_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_sync_cache();
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (error) {
+			printf("SWEET LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+sweet_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &sweet_log_secs, sizeof(sweet_log_secs));
+	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
+		sweet_log_secs = SWEET_LOG_SECS;
+	}
+	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int sweet_ufs_rootdev(dev_t *dev);
+
+int
+sweet_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = sweet_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
