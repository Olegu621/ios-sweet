diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
new file mode 100644
index 0000000..7d9eb1f
--- /dev/null
+++ b/bsd/dev/sweet_ufs.c
@@ -0,0 +1,1468 @@
+/*
+ * SWEET internal UFS root device.
+ *
+ * The Qualcomm UFS host (UFSHCI 2.1) is left enabled with the link up by the
+ * bootloader, which loaded our boot image from it. This driver reuses that
+ * state: it points the transfer request list at its own memory (verifying the
+ * host took it before ringing any doorbell) and issues polled SCSI commands,
+ * one at a time, to LUN 0. It finds one GPT partition by name (boot-arg
+ * ufsroot=, default "userdata") and exposes it as the BSD disk ufsroot0
+ * (rufsroot0), with 512-byte logical sectors over the device's 4 KiB blocks.
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
+ * cleaned/invalidated around each command.
+ *
+ * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
+ * against the partition bounds again right before it is issued, so nothing
+ * outside the named partition can be written.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/* osfmk/arm/cpu_data.h, not exported to the BSD layer */
+extern int get_preemption_level(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+static void sweet_log_start(void);
+static void sweet_ramoops_init(void);
+static void sweet_diag_start(void);
+extern void sweet_sample_start(void);
+extern void sweet_keys_init(void);
+extern void sweet_touch_init(void);
+extern int sweet_spmi_init(void);
+extern int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+extern void sweet_usb_probe(void);
+
+#define REG_CAP         0x00
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+/*
+ * UIC command block.  In the UFSHCI 2.x/3.x/4.x layout it lives at 0x90
+ * (in the 1.x layout 0x10 held CONTROLLER_PID, which is read only, so the
+ * 0087 attempt never reached the controller).  The configuration result of
+ * a UIC command comes back in ARG_2, a DME GET value in ARG_3.
+ */
+#define REG_UICCMD      0x90
+#define REG_UICCMDARG1  0x94
+#define REG_UICCMDARG2  0x98
+#define REG_UICCMDARG3  0x9c
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+#define HCS_UCRDY       (1u << 3)
+#define IS_UICCMD_COMP  (1u << 10)
+#define CAP_64AS        (1u << 24)              /* 64-bit DMA addressing */
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (1u << 20)
+#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+#define CMD_SPIN_NS     (50ull * NSEC_PER_USEC)
+#define CMD_SLEEP_NS    (200ull * NSEC_PER_USEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	struct {
+		uint32_t addr_lo, addr_hi, rsvd, dbc;
+	} prdt[PRDT_MAX];
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	bool writable;                          /* boot-arg ufsrw=1 */
+	bool cache;                             /* boot-arg ufscache=1 */
+	bool wait;                              /* boot-arg ufswait=1 */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} su;
+
+static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
+static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+static void
+dma_clean(uint32_t off, uint32_t len)
+{
+	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+/*
+ * One SCSI command in slot 0, data (if any) to/from the bounce buffer
+ * (to the device when write is set). Returns 0 or an errno.
+ */
+static int ufs_scsi_once(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write);
+
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	/*
+	 * After a device reset the first command comes back with a unit
+	 * attention ("power on, reset or bus device reset occurred", ASC
+	 * 0x29 in the sense data) and only the retry gets through - the
+	 * reference driver does the same.
+	 */
+	for (int attempt = 0; ; attempt++) {
+		int rc = ufs_scsi_once(cdb, cdb_len, len, write);
+
+		if (!rc || attempt || write) {
+			return rc;
+		}
+		printf("SWEET UFS: command 0x%02x refused, retrying\n", cdb[0]);
+	}
+}
+
+static int
+ufs_scsi_once(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+
+	assert(len <= BOUNCE_SIZE);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = len ? (write ? 0x20 : 0x40) : 0x00;      /* W: data out, R: data in */
+	ucd->cmd[2] = su.lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+
+	/* DD: 1 = memory to device, 2 = device to memory. */
+	utrd->dw0 = (1u << 28) | ((len ? (write ? 1u : 2u) : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		uint32_t n = 0;
+		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
+			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
+			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
+			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			ucd->prdt[n].dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+	}
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16 + cdb_len);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+		if (len) {
+			dma_clean(DMA_UCD + offsetof(struct ucd, prdt),
+			    (utrd->prdt & 0xffff) * sizeof(ucd->prdt[0]));
+		}
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len) {
+		if (su.cache && write) {
+			dma_clean(DMA_BOUNCE, len);
+		} else {
+			dma_sync(DMA_BOUNCE, len);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
+	    !ml_at_interrupt_context() && get_preemption_level() == 0;
+	uint64_t spin_until = 0, sleep_interval = 0;
+	if (sleepable) {
+		nanoseconds_to_absolutetime(CMD_SPIN_NS, &spin_until);
+		spin_until += mach_absolute_time();
+		nanoseconds_to_absolutetime(CMD_SLEEP_NS, &sleep_interval);
+	}
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		uint64_t now = mach_absolute_time();
+		if (now > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
+			return ETIMEDOUT;
+		}
+		if (sleepable && now >= spin_until) {
+			uint64_t wake = now + MIN(sleep_interval, deadline - now);
+			/* Keep the mutex: slot 0 and the bounce buffer are still owned. */
+			if (assert_wait_deadline_with_leeway((event_t)&su.wait, THREAD_UNINT,
+			    TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING) {
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+		} else {
+			delay(1);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len && !(su.cache && write)) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		/*
+		 * The sense data of a UFS 4.0 response sits behind the 12 byte
+		 * UPIU header, the residual count and four reserved dwords: its
+		 * length is a u16 at offset 32 and the 18 sense bytes follow.
+		 */
+		printf("SWEET UFS: sense len %u data %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    (unsigned)((ucd->resp[32] << 8) | ucd->resp[33]),
+		    ucd->resp[34], ucd->resp[35], ucd->resp[36], ucd->resp[37],
+		    ucd->resp[38], ucd->resp[39], ucd->resp[40], ucd->resp[41],
+		    ucd->resp[42], ucd->resp[43], ucd->resp[44], ucd->resp[45],
+		    ucd->resp[46], ucd->resp[47], ucd->resp[48], ucd->resp[49],
+		    ucd->resp[50], ucd->resp[51]);
+		printf("SWEET UFS: cdb %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x utrd %08x %08x %08x\n",
+		    ucd->cmd[16], ucd->cmd[17], ucd->cmd[18], ucd->cmd[19],
+		    ucd->cmd[20], ucd->cmd[21], ucd->cmd[22], ucd->cmd[23],
+		    ucd->cmd[24], ucd->cmd[25], utrd->dw0, utrd->dw1, utrd->dw2);
+		return EIO;
+	}
+	return 0;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
+}
+
+/*
+ * WRITE(10) of count device blocks from the bounce buffer to lba. The range
+ * must lie inside the partition: this is the only place data goes out.
+ */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
+	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX) {
+		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+static int
+ufs_sync_cache(void)
+{
+	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
+	return ufs_scsi(cdb, sizeof(cdb), 0, false);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		su.first_block = first;
+		su.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+/*
+ * UIC commands (JEDEC UFSHCI 2.1): command at 0x10, args at 0x14/0x18/0x1c,
+ * completion is IS bit 10 (0x400), the result word is UICCMDARG0 low 16 bits.
+ * Returns the full UICCMDARG0 or 0xffffffff on timeout.
+ */
+static uint32_t
+ufs_uic(uint32_t cmd, uint32_t arg1, uint32_t arg2, uint32_t arg3, uint32_t *out3)
+{
+	/* IS bits only set while the matching IE bit is one: enable completion. */
+	ufs_wr(REG_IE, IS_UICCMD_COMP);
+	ufs_wr(REG_UICCMDARG1, arg1);
+	ufs_wr(REG_UICCMDARG2, arg2);
+	ufs_wr(REG_UICCMDARG3, arg3);
+	ufs_wr(REG_UICCMD, cmd);
+	uint32_t is = 0;
+	for (int i = 0; i < 2000000; i++) {
+		is = ufs_rd(REG_IS);
+		if ((is & IS_UICCMD_COMP) != 0) {
+			uint32_t result = ufs_rd(REG_UICCMDARG2);
+			if (out3) {
+				*out3 = ufs_rd(REG_UICCMDARG3);
+			}
+			ufs_wr(REG_IS, IS_UICCMD_COMP);
+			ufs_wr(REG_IE, 0);
+			return result & 0xff;
+		}
+		delay(1);
+	}
+	ufs_wr(REG_IE, 0);
+	printf("SWEET UFS: UIC cmd 0x%x timed out (IS 0x%x)\n", cmd, is);
+	return 0xffffffffu;
+}
+
+/*
+ * DME GET / DME SET of a PA layer attribute (UniPro 1.8, JESD220).
+ * The attribute number goes into ARG_1 shifted up by 16 bits
+ * (UIC_ARG_MIB), the value into ARG_3.
+ */
+static uint32_t
+ufs_dme_get(uint32_t mib, uint32_t *val)
+{
+	uint32_t v = 0;
+	uint32_t r = ufs_uic(0x01, mib << 16, 0, 0, &v);
+
+	if (val) {
+		*val = v;
+	}
+	printf("SWEET UFS: DME GET mib 0x%x result %u value 0x%x\n", mib, r, v);
+	return r;
+}
+
+static uint32_t
+ufs_dme_set(uint32_t mib, uint32_t val)
+{
+	uint32_t r = ufs_uic(0x02, mib << 16, 0, val, NULL);
+
+	printf("SWEET UFS: DME SET mib 0x%x value 0x%x result %u\n", mib, val, r);
+	return r;
+}
+
+/*
+ * Bring the UniPro link and the device up the way the reference driver
+ * does: a DME RESET, a DME ENABLE and a DME LINK STARTUP.  After the reset
+ * the device only accepts the fDeviceInit handshake and its SCSI commands
+ * come back with a unit attention until they are retried, and the host
+ * side transfer request list has to be taken over again.
+ */
+static int
+ufs_link_init(void)
+{
+	uint32_t r;
+
+	printf("SWEET UFS: UIC link init (IS 0x%x IE 0x%x HCS 0x%x)\n",
+	    ufs_rd(REG_IS), ufs_rd(REG_IE), ufs_rd(REG_HCS));
+	r = ufs_uic(0x14, 0, 0, 0, NULL);      /* DME RESET */
+	printf("SWEET UFS: DME RESET result %u IS 0x%x\n", r, ufs_rd(REG_IS));
+	r = ufs_uic(0x12, 0, 0, 0, NULL);      /* DME ENABLE */
+	printf("SWEET UFS: DME ENABLE result %u IS 0x%x\n", r, ufs_rd(REG_IS));
+	r = ufs_uic(0x16, 0, 0, 0, NULL);      /* DME LINK STARTUP */
+	printf("SWEET UFS: DME LINK STARTUP result %u IS 0x%x HCS 0x%x\n",
+	    r, ufs_rd(REG_IS), ufs_rd(REG_HCS));
+	return ((r != 0xffffffffu) && ((r & 0xffff) == 0)) ? 0 : ENXIO;
+}
+
+/*
+ * A NOP OUT UPIU (type 0x00).  The reference driver sends it as the very
+ * first thing after the link is up: the device answers with a NOP IN and
+ * that proves it has finished its own initialisation.
+ */
+static int
+ufs_nop_out(void)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+	uint32_t ocs;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x00;                     /* NOP OUT UPIU */
+	ucd->cmd[3] = ++su.tag;
+
+	utrd->dw0 = (1u << 28) | (1u << 24);    /* CT=1, DD=0, I=1 */
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: NOP OUT timed out\n");
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	ocs = utrd->dw2 & 0xff;
+	printf("SWEET UFS: NOP OUT ocs 0x%x upiu 0x%x\n", ocs, ucd->resp[0]);
+	return ocs ? EIO : 0;
+}
+
+/*
+ * A QUERY request (UPIU type 0x16).  The payload is "struct utp_upiu_query":
+ * opcode, idn, index, selector, reserved, length, value, reserved.  The
+ * answer arrives in the QUERY response UPIU (type 0x36); its value field
+ * sits at offset 20 (12 byte UPIU header + 8).
+ */
+static int
+ufs_query_len(uint8_t opcode, uint8_t idn, uint32_t len, uint32_t value,
+    uint32_t *rsp_value)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+	uint32_t ocs;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x16;                     /* QUERY REQUEST UPIU */
+	ucd->cmd[1] = 0x00;
+	ucd->cmd[2] = 0x00;                     /* LUN */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[4] = 0x00;                     /* command set type / IID */
+	ucd->cmd[5] = (opcode == 0x01 || opcode == 0x03 || opcode == 0x05) ?
+	    0x01 : 0x81;                       /* standard read / write request */
+	/*
+	 * The query payload starts right behind the 12 byte UPIU header
+	 * (struct utp_upiu_query), not behind a data length field like the
+	 * command UPIU has: opcode, idn, index, selector, reserved, length,
+	 * value.
+	 */
+	ucd->cmd[12] = opcode;
+	ucd->cmd[13] = idn;
+	ucd->cmd[14] = 0;                       /* index */
+	ucd->cmd[15] = 0;                       /* selector */
+	ucd->cmd[18] = (uint8_t)(len >> 8);      /* length */
+	ucd->cmd[19] = (uint8_t)len;
+	ucd->cmd[20] = (uint8_t)(value >> 24);
+	ucd->cmd[21] = (uint8_t)(value >> 16);
+	ucd->cmd[22] = (uint8_t)(value >> 8);
+	ucd->cmd[23] = (uint8_t)value;
+
+	/* No data phase: DD = 0, command type 1 (UFS storage device). */
+	utrd->dw0 = (1u << 28) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 24);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: QUERY 0x%02x timed out\n", opcode);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+
+	ocs = utrd->dw2 & 0xff;
+	uint32_t type = ucd->resp[0], rcode = ucd->resp[6];
+	uint32_t v = (ucd->resp[20] << 24) | (ucd->resp[21] << 16) |
+	    (ucd->resp[22] << 8) | ucd->resp[23];
+	if (rsp_value) {
+		*rsp_value = v;
+	}
+	printf("SWEET UFS: QUERY opcode 0x%02x idn 0x%02x: ocs 0x%x type 0x%x code 0x%x value 0x%x\n",
+	    opcode, idn, ocs, type, rcode, v);
+	if (ocs || type != 0x36 || rcode) {
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+ufs_query(uint8_t opcode, uint8_t idn, uint32_t value, uint32_t *rsp_value)
+{
+	return ufs_query_len(opcode, idn, 0, value, rsp_value);
+}
+
+
+/*
+ * START STOP UNIT on the well known "device" LUN (the UPIU LUN byte of
+ * SCSI LUN 0xc150 is 0xd0).  The power condition modifier selects the
+ * device power mode: 0x00 active, 0x10 sleep, 0x20 power down.  Going
+ * down and up again is the UFS level equivalent of the VCC toggle the
+ * reference driver does with the device.
+ */
+static int
+ufs_start_stop(uint8_t pcm)
+{
+	uint8_t cdb[6] = { 0x1e, 0, 0, 0, pcm, 0 };
+	uint8_t lun = su.lun;
+	int error;
+
+	su.lun = 0xd0;                          /* the well known device LUN */
+	error = ufs_scsi(cdb, sizeof(cdb), 0, false);
+	su.lun = lun;
+	printf("SWEET UFS: START STOP UNIT pcm 0x%x: %s\n", pcm,
+	    error ? "refused" : "ok");
+	return error;
+}
+
+/*
+ * The UFS 3.0/4.0 device initialisation handshake: the host sets the
+ * fDeviceInit flag and waits for the device to clear it again (Linux
+ * ufshcd_complete_dev_init).  The device descriptor of this UFS 4.0 part
+ * says bInitialPowerMode = 01h, i.e. the device comes up in Sleep power
+ * mode and answers every SCSI command with CHECK CONDITION / NOT READY
+ * until the host has moved it out of it.
+ */
+static int
+ufs_fdeviceinit(void)
+{
+	uint32_t v = 0, r;
+
+	r = ufs_query(0x06, 0x01, 0, NULL);     /* SET_FLAG fDeviceInit */
+	printf("SWEET UFS: fDeviceInit set result %u\n", r);
+	for (int i = 0; i < 50; i++) {
+		v = 0xffffffff;
+		r = ufs_query(0x05, 0x01, 0, &v); /* READ_FLAG fDeviceInit */
+		printf("SWEET UFS: fDeviceInit read result %u value 0x%x\n", r, v);
+		if (r == 0 && !(v & 1)) {
+			return 0;
+		}
+	}
+	return EIO;
+}
+
+/*
+ * Configure the M-PHY for the negotiated gear and move the device into the
+ * Fast power mode (Linux ufshcd_dme_change_power_mode).  The PA layer
+ * attribute numbers are the UniPro 1.8 ones (JESD220).
+ */
+static void
+ufs_power_mode(void)
+{
+	uint32_t lanes_rx = 0, lanes_tx = 0, gear_rx = 0, gear_tx = 0, v = 0;
+
+	ufs_dme_get(0x1581, &lanes_rx);         /* PA_CONNECTEDRXDATALANES */
+	ufs_dme_get(0x1561, &lanes_tx);         /* PA_CONNECTEDTXDATALANES */
+	ufs_dme_get(0x1587, &gear_rx);          /* PA_MAXRXHSGEAR */
+	ufs_uic(0x03, 0x1587 << 16, 0, 0, &gear_tx);   /* peer: PA_MAXRXHSGEAR */
+	if (!gear_tx) {
+		gear_tx = gear_rx;
+	}
+	ufs_dme_get(0x1571, &v);                /* PA_PWRMODE */
+	printf("SWEET UFS: lanes %u/%u gears %u/%u power mode 0x%x\n",
+	    lanes_rx, lanes_tx, gear_rx, gear_tx, v);
+
+	ufs_dme_set(0x1583, gear_rx);           /* PA_RXGEAR */
+	ufs_dme_set(0x1580, lanes_rx);          /* PA_ACTIVERXDATALANES */
+	ufs_dme_set(0x1584, 1);                 /* PA_RXTERMINATION */
+	ufs_dme_set(0x1568, gear_tx);           /* PA_TXGEAR */
+	ufs_dme_set(0x1560, lanes_tx);          /* PA_ACTIVETXDATALANES */
+	ufs_dme_set(0x1569, 1);                 /* PA_TXTERMINATION */
+	ufs_dme_set(0x156a, 2);                 /* PA_HSSERIES: rate B */
+	ufs_dme_set(0x1571, 0x11);              /* PA_PWRMODE: fast / fast */
+	ufs_dme_get(0x1571, &v);
+	printf("SWEET UFS: power mode now 0x%x\n", v);
+}
+
+static int ufs_nop_out(void);
+static int ufs_fdeviceinit(void);
+static int ufs_query_len(uint8_t opcode, uint8_t idn, uint32_t len,
+    uint32_t value, uint32_t *rsp_value);
+static void ufs_power_mode(void);
+
+/*
+ * The whole device initialisation the reference driver does before it
+ * talks to the device: a NOP OUT, the fDeviceInit handshake, the device
+ * and configuration descriptors and the PA layer power mode change.
+ */
+static void
+ufs_device_init(void)
+{
+	ufs_nop_out();
+	ufs_fdeviceinit();
+	ufs_query_len(0x01, 0x00, 0x40, 0, NULL);  /* device descriptor */
+	ufs_query_len(0x01, 0x01, 0x20, 0, NULL);  /* configuration descriptor */
+	ufs_power_mode();
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("SWEET UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("SWEET UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	/* With RAM above 4 GiB (mkadt.py --highmem) the DMA memory can be there too. */
+	if (((su.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
+		printf("SWEET UFS: DMA memory at 0x%llx but the host has no 64-bit addressing\n",
+		    su.dma_pa);
+		return ENXIO;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("SWEET UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+sweet_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !su.writable) ? EROFS : 0;
+}
+
+static int
+sweet_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !su.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		void *bounce = (void *)(su.dma + DMA_BOUNCE);
+		if (rd) {
+			error = ufs_read_blocks(su.first_block + lba, blocks);
+			if (!error) {
+				memcpy(vaddr + done, (const char *)bounce + skip, want);
+			}
+		} else {
+			/* Partial device blocks at either end: read, merge, write back. */
+			if (skip || (want % UFS_BLOCK)) {
+				error = ufs_read_blocks(su.first_block + lba, blocks);
+			}
+			if (!error) {
+				memcpy((char *)bounce + skip, vaddr + done, want);
+				error = ufs_write_blocks(su.first_block + lba, blocks);
+			}
+		}
+		if (error) {
+			break;
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = su.writable;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		if (!su.writable) {
+			return 0;
+		}
+		lck_mtx_lock(&sweet_ufs_lock);
+		int error = ufs_sync_cache();
+		lck_mtx_unlock(&sweet_ufs_lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = su.writable ? BOUNCE_SIZE / su.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+sweet_ufs_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!su.writable) {
+		return EROFS;
+	}
+	return physio(sweet_ufs_strategy, NULL, dev, B_WRITE, minphys, uio, (int)su.secsize);
+}
+
+static const struct bdevsw sweet_ufs_bdevsw = {
+	.d_open     = sweet_ufs_open,
+	.d_close    = sweet_ufs_close,
+	.d_strategy = sweet_ufs_strategy,
+	.d_ioctl    = sweet_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_ufs_psize,
+	.d_type     = D_DISK,
+};
