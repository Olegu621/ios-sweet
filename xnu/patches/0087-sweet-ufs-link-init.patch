+/*
+ * UIC commands (JEDEC UFSHCI 2.1): command at 0x10, args at 0x14/0x18/0x1c,
+ * completion is IS bit 10 (0x400), the result word is UICCMDARG0 low 16 bits.
+ * Returns the full UICCMDARG0 or 0xffffffff on timeout.
+ */
+static uint32_t
+ufs_uic(uint32_t cmd, uint32_t arg0)
+{
+	ufs_wr(REG_UICCMDARG0, arg0);
+	ufs_wr(REG_UICCMDARG1, 0);
+	ufs_wr(REG_UICCMDARG2, 0);
+	ufs_wr(REG_UICCMD, cmd);
+	for (int i = 0; i < 2000000; i++) {
+		if ((ufs_rd(REG_IS) & IS_UICCMD_COMP) != 0) {
+			uint32_t result = ufs_rd(REG_UICCMDARG0);
+			ufs_wr(REG_IS, IS_UICCMD_COMP);
+			return result;
+		}
+		delay(1);
+	}
+	return 0xffffffffu;
+}
+
+/*
+ * After some bootloader states (observed after a large fastboot flash: CAP
+ * 0xD5C7031F instead of 0x1587031F, CHECK-CONDITION responses with all-zero
+ * sense data) the UIC link is no longer established. DME LINK STARTUP (0x16),
+ * with an HCE power cycle when it is refused, brings it back. Always run once.
+ */
+static int
+ufs_link_init(void)
+{
+	uint32_t r = ufs_uic(0x16, 0);          /* DME LINK STARTUP */
+	printf("SWEET UFS: DME LINK STARTUP result 0x%x\n", r);
+	if ((r != 0xffffffffu) && ((r & 0xffff) == 0)) {
+		return 0;
+	}
+	printf("SWEET UFS: HCE reset\n");
+	ufs_wr(REG_HCE, 0);
+	for (int i = 0; i < 100000; i++) {
+		delay(1);
+	}
+	ufs_wr(REG_HCE, 1);
+	uint32_t hcs = 0;
+	for (int i = 0; i < 1000000; i++) {
+		hcs = ufs_rd(REG_HCS);
+		if (hcs & HCS_DP) {
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET UFS: HCS after HCE reset 0x%x\n", hcs);
+	r = ufs_uic(0x16, 0);
+	printf("SWEET UFS: DME LINK STARTUP result 0x%x\n", r);
+	return ((r != 0xffffffffu) && ((r & 0xffff) == 0)) ? 0 : ENXIO;
+}
