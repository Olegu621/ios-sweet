 void sweet_early_panic(const char *fmt, va_list *args);
+void sweet_early_hex(unsigned long long v);
+void sweet_early_dec(unsigned long v);
+void sweet_early_trace(vm_offset_t fp);
+int sweet_early_panic_started(void);
 void sweet_early_relocate(uint64_t base);
 void sweet_early_disable(void);
 #else
